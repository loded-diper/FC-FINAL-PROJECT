{
  "name": "campusconnect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "db:init": "node server/migrate.js",
    "db:seed": "node server/seed.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js",
    "test:browser": "node tests/browser.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.16",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "tailwindcss": "4.1.16",
    "vite": "7.3.7"
  }
}
